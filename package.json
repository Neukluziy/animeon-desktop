{
  "name": "animeon-desktop",
  "productName": "AnimeOn",
  "version": "1.5.0",
  "description": "AnimeOn desktop",
  "main": "main.js",
  "author": "Neukluziy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node tools/check.js",
    "test": "node --test",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "co.animeon.desktop",
    "productName": "AnimeOn",
    "copyright": "Copyright © 2026 Neukluziy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app/**",
      "renderer/**",
      "shared/**",
      "windows/**",
      "styles/**",
      "assets/**",
      "main.js",
      "package.json",
      "package-lock.json",
      "LICENSE"
    ],
    "compression": "normal",
    "win": {
      "icon": "assets/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AnimeOn-Setup-${version}.exe",
      "shortcutName": "AnimeOn"
    },
    "portable": {
      "artifactName": "AnimeOn-Portable-${version}.exe"
    },
    "protocols": [
      {
        "name": "AnimeOn Link",
        "schemes": [
          "animeon"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@44.5.1": true
  }
}
