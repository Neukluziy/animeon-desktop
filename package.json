{
  "name": "animeon-desktop",
  "productName": "AnimeOn",
  "version": "1.5.3",
  "description": "AnimeOn desktop",
  "main": "main.js",
  "author": "Neukluziy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prestart": "npm run build:css",
    "build:css": "esbuild styles/main.css --bundle --minify --outfile=styles/main.bundle.css",
    "check": "node tools/check.js",
    "lint": "eslint app renderer shared windows tools main.js eslint.config.js",
    "format": "prettier --write \"app/**/*.js\" \"renderer/**/*.js\" \"shared/**/*.js\" \"windows/**/*.js\" \"tools/**/*.js\" \"index.html\" \"package.json\" \"eslint.config.js\"",
    "predist": "npm run build:css",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10"
  },
  "build": {
    "appId": "co.animeon.desktop",
    "productName": "AnimeOn",
    "copyright": "Copyright © 2026 Neukluziy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app/**",
      "renderer/**",
      "shared/**",
      "windows/**",
      "styles/**",
      "assets/**",
      "main.js",
      "package.json",
      "package-lock.json",
      "LICENSE"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "ru",
      "en-US",
      "uk"
    ],
    "win": {
      "icon": "assets/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AnimeOn-Setup-${version}.exe",
      "shortcutName": "AnimeOn"
    },
    "portable": {
      "artifactName": "AnimeOn-Portable-${version}.exe"
    },
    "protocols": [
      {
        "name": "AnimeOn Link",
        "schemes": [
          "animeon"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@44.5.1": true
  }
}
