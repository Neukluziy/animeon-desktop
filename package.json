{
  "name": "animeon-desktop",
  "productName": "AnimeOn",
  "version": "1.3.3",
  "description": "AnimeOn desktop",
  "main": "main.js",
  "author": "Neukluziy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\png-to-ico.ps1",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "co.animeon.desktop",
    "productName": "AnimeOn",
    "copyright": "Copyright © 2026 Neukluziy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "tray.html",
      "tray.css",
      "tray.js",
      "update.html",
      "update.css",
      "update.js",
      "assets/**"
    ],
    "compression": "normal",
    "win": {
      "icon": "assets/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AnimeOn-Setup-${version}.exe",
      "shortcutName": "AnimeOn"
    },
    "portable": {
      "artifactName": "AnimeOn-Portable-${version}.exe"
    }
  }
}
